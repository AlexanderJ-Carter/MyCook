# 菜谱链接默认指向 Pages CDN 主站（与 compose 默认一致）
SITE_URL=https://cook.alexander.xin
# 图片版完整站（文档用；站点 UI 已硬链 mycook）
# FULL_SITE_URL=https://mycook.alexander.xin

MCP_PUBLIC_URL=https://cook-mcp.alexander.xin
OIDC_ISSUER=https://id.alexander.xin
OIDC_AUDIENCE=https://cook-mcp.alexander.xin/mcp
AUTH_REQUIRED=1

# 逗号分隔静态 Bearer（脚本/备用）。生产优先用 Pocket ID JWT。
# MCP_API_KEYS=

# 厨助手 POST /ask → OmniRoute（不配则仅站内检索）
# OMNI_URL=http://100.111.222.66:8180
# OMNI_KEY=sk-...
# OMNI_MODEL=gemini/gemini-3.1-flash-lite
