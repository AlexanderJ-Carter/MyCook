{
  "name": "my-cook",
  "version": "1.8.3",
  "private": true,
  "type": "module",
  "description": "老乡鸡风格菜谱 + 程序员做饭指南 — 静态站点、Docker 镜像与 MCP Agent 就绪",
  "author": "AlexanderJ-Carter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderJ-Carter/MyCook.git"
  },
  "homepage": "https://cook.alexander.xin",
  "bin": {
    "mycook": "./bin/mycook.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync": "node scripts/sync-upstream.js",
    "sync:integrations": "node scripts/sync-integrations.js",
    "build:images": "node scripts/build-howtocook-images.js",
    "generate": "node scripts/generate-all.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "docs:dev": "npm run generate && vitepress dev .",
    "docs:build": "npm run build:images && npm run generate && vitepress build . && npm run generate:sitemap",
    "docs:build:fast": "SKIP_IMAGES=1 node scripts/build-howtocook-images.js && npm run generate && vitepress build . && npm run generate:sitemap && node scripts/write-image-manifest.js",
    "docs:preview": "vitepress preview .",
    "mycook": "node bin/mycook.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:http": "node mcp/server.mjs http",
    "validate": "node scripts/validate.mjs",
    "build": "npm run docs:build",
    "start": "npm run docs:dev",
    "docker:build": "docker build --build-arg SKIP_IMAGES=1 -t mycook:lite .",
    "docker:build:full": "docker build --build-arg SKIP_IMAGES=0 -t mycook:full .",
    "docker:run": "docker run -d -p 8080:80 --name mycook mycook:lite"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.2",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "postcss": ">=8.5.10",
    "vite": "6.4.3",
    "esbuild": ">=0.25.0",
    "fast-uri": ">=3.1.8",
    "nanoid": ">=3.3.18",
    "source-map-js": ">=1.2.2",
    "proxy-addr": ">=2.0.8",
    "vue": ">=3.5.42",
    "@vue/server-renderer": ">=3.5.42"
  }
}
